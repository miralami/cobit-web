{
  "objectives": [
    {
      "id": "EDM01",
      "name": "Ensured  Governance Framework Setting & Maintenance",
      "domain": "EDM",
      "description": "Ensure that the governance framework for I&T is established and maintained, with clearly defined roles, responsibilities, and decision rights across the enterprise.",
      "purpose": "Ensure governance framework for I&T is established and maintained"
    },
    {
      "id": "EDM02",
      "name": "Ensured Benefits Delivery",
      "domain": "EDM",
      "description": "Ensure that I&T contributes to the optimization of business benefits through delivery of services and solutions that meet enterprise requirements.",
      "purpose": "Ensure optimization of I&T business benefits"
    },
    {
      "id": "EDM03",
      "name": "Ensured Risk Optimization",
      "domain": "EDM",
      "description": "Ensure that IT-related enterprise risk does not exceed risk appetite and risk tolerance, and that risk is identified and managed effectively.",
      "purpose": "Ensure IT risk does not exceed appetite and tolerance"
    },
    {
      "id": "EDM04",
      "name": "Ensured Resource Optimization",
      "domain": "EDM",
      "description": "Ensure that the optimal I&T resources are maintained and used to achieve enterprise objectives, balancing cost, quality, and responsiveness.",
      "purpose": "Ensure optimization of I&T resources"
    },
    {
      "id": "EDM05",
      "name": "Ensured Stakeholder Engagement",
      "domain": "EDM",
      "description": "Ensure that stakeholders are engaged to understand needs and expectations, and that I&T priorities are aligned with enterprise strategy.",
      "purpose": "Ensure stakeholder engagement for I&T alignment"
    },
    {
      "id": "APO01",
      "name": "Managed I&T Management Framework",
      "domain": "APO",
      "description": "Ensure that the I&T management framework is implemented and maintained, aligning I&T strategy with enterprise governance requirements.",
      "purpose": "Align I&T management framework with enterprise governance"
    },
    {
      "id": "APO02",
      "name": "Managed Strategy",
      "domain": "APO",
      "description": "Ensure that I&T strategy supports enterprise strategy, enabling innovation and competitive advantage through technology.",
      "purpose": "Align I&T strategy with enterprise strategy"
    },
    {
      "id": "APO03",
      "name": "Managed Enterprise Architecture",
      "domain": "APO",
      "description": "Ensure that the enterprise architecture is maintained to support current and future business requirements, enabling integration and standardization.",
      "purpose": "Maintain enterprise architecture for business alignment"
    },
    {
      "id": "APO04",
      "name": "Managed Innovation",
      "domain": "APO",
      "description": "Ensure that innovation is fostered and managed to identify and exploit new technologies that create business opportunities.",
      "purpose": "Foster and manage I&T innovation"
    },
    {
      "id": "APO05",
      "name": "Managed Portfolio",
      "domain": "APO",
      "description": "Ensure that I&T initiatives and investments are prioritized and managed as a portfolio to maximize value and strategic alignment.",
      "purpose": "Manage I&T initiatives as a portfolio"
    },
    {
      "id": "APO06",
      "name": "Managed Budget & Costs",
      "domain": "APO",
      "description": "Ensure that I&T budgets and costs are optimized and aligned with enterprise financial constraints and priorities.",
      "purpose": "Optimize I&T budget and costs"
    },
    {
      "id": "APO07",
      "name": "Managed Human Resources",
      "domain": "APO",
      "description": "Ensure that the I&T workforce has the right skills, motivation, and capacity to deliver current and future services.",
      "purpose": "Manage I&T human resources"
    },
    {
      "id": "APO08",
      "name": "Managed Relationships",
      "domain": "APO",
      "description": "Ensure that relationships with internal and external stakeholders are managed to support I&T objectives and service delivery.",
      "purpose": "Manage I&T stakeholder relationships"
    },
    {
      "id": "APO09",
      "name": "Managed Service Agreements",
      "domain": "APO",
      "description": "Ensure that service agreements with internal and external providers are defined, monitored, and aligned with business needs.",
      "purpose": "Manage I&T service agreements"
    },
    {
      "id": "APO10",
      "name": "Managed Vendors",
      "domain": "APO",
      "description": "Ensure that vendors and third-party providers are selected, managed, and monitored to deliver value and meet contractual obligations.",
      "purpose": "Manage I&T vendors and suppliers"
    },
    {
      "id": "APO11",
      "name": "Managed Quality",
      "domain": "APO",
      "description": "Ensure that I&T quality is defined, measured, and managed to meet enterprise requirements and stakeholder expectations.",
      "purpose": "Manage I&T quality"
    },
    {
      "id": "APO12",
      "name": "Managed Risk",
      "domain": "APO",
      "description": "Ensure that risk is identified, assessed, and managed across all I&T activities, aligned with enterprise risk management.",
      "purpose": "Manage I&T risk"
    },
    {
      "id": "APO13",
      "name": "Managed Security",
      "domain": "APO",
      "description": "Ensure that information security is managed to protect the confidentiality, integrity, and availability of enterprise information assets.",
      "purpose": "Manage I&T security"
    },
    {
      "id": "APO14",
      "name": "Managed Data",
      "domain": "APO",
      "description": "Ensure that data and information are managed as assets, with defined ownership, quality standards, and lifecycle management.",
      "purpose": "Manage I&T data and information"
    },
    {
      "id": "BAI01",
      "name": "Managed Programs",
      "domain": "BAI",
      "description": "Ensure that programs are planned, executed, and monitored to deliver agreed benefits and capabilities on time and within budget.",
      "purpose": "Manage I&T programs and benefits delivery"
    },
    {
      "id": "BAI02",
      "name": "Managed Requirements Definition",
      "domain": "BAI",
      "description": "Ensure that business requirements are clearly defined, documented, and agreed before solution development begins.",
      "purpose": "Define and document business requirements"
    },
    {
      "id": "BAI03",
      "name": "Managed Solutions Identification & Build",
      "domain": "BAI",
      "description": "Ensure that solutions are identified, designed, and built to meet defined business requirements using appropriate technology.",
      "purpose": "Identify and build I&T solutions"
    },
    {
      "id": "BAI04",
      "name": "Managed Availability & Capacity",
      "domain": "BAI",
      "description": "Ensure that IT services are available and have sufficient capacity to meet current and future business demands.",
      "purpose": "Manage I&T availability and capacity"
    },
    {
      "id": "BAI05",
      "name": "Managed Organizational Change",
      "domain": "BAI",
      "description": "Ensure that organizational change is planned and managed to minimize resistance and maximize adoption of new I&T-enabled processes.",
      "purpose": "Manage organizational change for I&T"
    },
    {
      "id": "BAI06",
      "name": "Managed IT Changes",
      "domain": "BAI",
      "description": "Ensure that IT changes are assessed, approved, and implemented in a controlled manner to minimize risk and disruption.",
      "purpose": "Manage I&T changes"
    },
    {
      "id": "BAI07",
      "name": "Managed IT Change Acceptance and Transitioning",
      "domain": "BAI",
      "description": "Ensure that changes are accepted by users and transitioned into operational use smoothly, with adequate training and support.",
      "purpose": "Manage I&T change acceptance and transition"
    },
    {
      "id": "BAI08",
      "name": "Managed Knowledge",
      "domain": "BAI",
      "description": "Ensure that knowledge is captured, shared, and maintained to support continuous improvement and informed decision-making.",
      "purpose": "Manage I&T knowledge and information"
    },
    {
      "id": "BAI09",
      "name": "Managed Assets",
      "domain": "BAI",
      "description": "Ensure that IT assets are inventoried, managed, and protected throughout their lifecycle to maximize value and minimize risk.",
      "purpose": "Manage I&T assets"
    },
    {
      "id": "BAI10",
      "name": "Managed Configuration",
      "domain": "BAI",
      "description": "Ensure that the IT configuration is documented, controlled, and maintained to support change management and service continuity.",
      "purpose": "Manage I&T configuration"
    },
    {
      "id": "BAI11",
      "name": "Managed Projects",
      "domain": "BAI",
      "description": "Ensure that projects are planned, executed, and monitored to deliver scope, quality, and benefits on time and within budget.",
      "purpose": "Manage I&T projects"
    },
    {
      "id": "DSS01",
      "name": "Managed Operations",
      "domain": "DSS",
      "description": "Ensure that IT operations are performed reliably and efficiently, with defined procedures, monitoring, and incident response.",
      "purpose": "Manage I&T operations"
    },
    {
      "id": "DSS02",
      "name": "Managed Service Requests & Incidents",
      "domain": "DSS",
      "description": "Ensure that service requests and incidents are logged, categorized, and resolved within agreed service levels.",
      "purpose": "Manage I&T service requests and incidents"
    },
    {
      "id": "DSS03",
      "name": "Managed Problems",
      "domain": "DSS",
      "description": "Ensure that problems are identified, root-caused, and resolved to prevent recurrence and minimize business impact.",
      "purpose": "Manage I&T problems"
    },
    {
      "id": "DSS04",
      "name": "Managed Continuity",
      "domain": "DSS",
      "description": "Ensure that IT services can continue or recover within agreed timeframes following a major disruption or disaster.",
      "purpose": "Manage I&T continuity"
    },
    {
      "id": "DSS05",
      "name": "Managed Security Services",
      "domain": "DSS",
      "description": "Ensure that security services are operated to detect, prevent, and respond to threats, protecting information assets.",
      "purpose": "Manage I&T security services"
    },
    {
      "id": "DSS06",
      "name": "Managed Business Process Controls",
      "domain": "DSS",
      "description": "Ensure that business process controls are operated effectively to maintain integrity, accuracy, and compliance of information.",
      "purpose": "Manage business process controls"
    },
    {
      "id": "MEA01",
      "name": "Managed Performance and Conformance Monitoring",
      "domain": "MEA",
      "description": "Ensure that I&T performance and conformance with policies, standards, and targets is measured, reported, and acted upon.",
      "purpose": "Monitor I&T performance and conformance"
    },
    {
      "id": "MEA02",
      "name": "Managed System of Internal Control",
      "domain": "MEA",
      "description": "Ensure that the system of internal control is designed, implemented, and operating effectively to manage risk and support objectives.",
      "purpose": "Monitor internal control system"
    },
    {
      "id": "MEA03",
      "name": "Managed Compliance with External Requirements",
      "domain": "MEA",
      "description": "Ensure that compliance with external laws, regulations, and contractual obligations is monitored and maintained.",
      "purpose": "Monitor compliance with external requirements"
    },
    {
      "id": "MEA04",
      "name": "Managed Assurance",
      "domain": "MEA",
      "description": "Ensure that assurance activities are planned and executed to provide independent confidence that I&T objectives are being achieved.",
      "purpose": "Monitor I&T assurance"
    }
  ],
