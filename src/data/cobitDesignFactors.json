  "df4_categories": [
    {
      "id": "ISS01",
      "index": 1,
      "description": "Frustration between different IT entities across the organization because of a perception of low contribution to business value",
      "baseline": 2
    },
    {
      "id": "ISS02",
      "index": 2,
      "description": "Frustration between business departments (i.e., the IT customer) and the IT department because of failed initiatives or a perception of low contribution to business value",
      "baseline": 2
    },
    {
      "id": "ISS03",
      "index": 3,
      "description": "Significant IT-related incidents, such as data loss, security breaches, project failure and application errors, linked to IT",
      "baseline": 2
    },
    {
      "id": "ISS04",
      "index": 4,
      "description": "Service delivery problems by the IT outsourcer(s)",
      "baseline": 2
    },
    {
      "id": "ISS05",
      "index": 5,
      "description": "Failures to meet IT-related regulatory or contractual requirements",
      "baseline": 2
    },
    {
      "id": "ISS06",
      "index": 6,
      "description": "Regular audit findings or other assessment reports about poor IT performance or reported IT quality or service problems",
      "baseline": 2
    },
    {
      "id": "ISS07",
      "index": 7,
      "description": "Substantial hidden and rogue IT spending, that is, IT spending by user departments outside the control of the normal IT investment decision mechanisms and approved budgets",
      "baseline": 2
    },
    {
      "id": "ISS08",
      "index": 8,
      "description": "Duplications or overlaps between various initiatives or other forms of wasted resources",
      "baseline": 2
    },
    {
      "id": "ISS09",
      "index": 9,
      "description": "Insufficient IT resources, staff with inadequate skills or staff burnout / dissatisfaction",
      "baseline": 2
    },
    {
      "id": "ISS10",
      "index": 10,
      "description": "IT-enabled changes or projects frequently failing to meet business needs and delivered late or over budget",
      "baseline": 2
    },
    {
      "id": "ISS11",
      "index": 11,
      "description": "Reluctance by board members, executives or senior management to engage with IT, or a lack of committed business sponsorship for IT",
      "baseline": 2
    },
    {
      "id": "ISS12",
      "index": 12,
      "description": "Complex IT operating model and/or unclear decision mechanisms for IT-related decisions",
      "baseline": 2
    },
    {
      "id": "ISS13",
      "index": 13,
      "description": "Excessively high cost of IT",
      "baseline": 2
    },
    {
      "id": "ISS14",
      "index": 14,
      "description": "Obstructed or failed implementation of new initiatives or innovations caused by the current IT architecture and systems",
      "baseline": 2
    },
    {
      "id": "ISS15",
      "index": 15,
      "description": "Gap between business and technical knowledge, which leads to business  users and information and/or technology specialists speaking different languages",
      "baseline": 2
    },
    {
      "id": "ISS16",
      "index": 16,
      "description": "Regular issues with data quality and integration of data across various sources",
      "baseline": 2
    },
    {
      "id": "ISS17",
      "index": 17,
      "description": "High level of end-user computing, creating (among other problems) a lack of oversight and quality control over the applications that are being developed and put in operation",
      "baseline": 2
    },
    {
      "id": "ISS18",
      "index": 18,
      "description": "Business departments implementing their own information solutions with little or no involvement of the enterprise IT department",
      "baseline": 2
    },
    {
      "id": "ISS19",
      "index": 19,
      "description": "Ignorance of and/or noncompliance with privacy regulations",
      "baseline": 2
    },
    {
      "id": "ISS20",
